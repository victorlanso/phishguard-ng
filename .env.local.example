# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App URL (used for tracking links in emails)
# On Vercel this will be your production URL, e.g. https://phishguard.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend – for real simulation emails
# 1. Create account at https://resend.com
# 2. Create an API key
# 3. (Optional) Verify your domain for production sending
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=PhishGuard Simulation <onboarding@resend.dev>
